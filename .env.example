# ---- 上游数据源 ----
# 单个上游请求的超时时间（毫秒），默认 8000
UPSTREAM_TIMEOUT_MS=8000

# ---- 同花顺 iFinD（可选）----
# 配置后，财务摘要会自动从「行情估值派生」切换为「真实三表财报」，无需改代码。
# IFIND_BASE_URL=https://your-ifind-endpoint/v1
# IFIND_TOKEN=your-token
# 走 MCP 网关时改用：
# IFIND_MCP_URL=http://iFinD-MCP.agent-gateway.auth-proxy.local/ds-mcp-servers/hexin-ifind-financial-mcp

# ---- 运行 ----
# PORT=3000

# ---- 公共市场数据持久化（与个人数据/WorkBuddy浏览器云服务分开）----
# 生产使用服务器可访问的PostgreSQL连接，优先于旧的DATABASE_URL。
# MARKET_DATABASE_URL=postgresql://user:password@host:5432/database
# 本地单进程预览可使用文件适配器；生产仅在明确配置持久卷时使用此项。
# MARKET_DATA_DIR=/persistent-volume/fin-terminal-market
# 紧急回退为原有上游读取，不删除已存数据：
# MARKET_DATA_STORE=off

# ---- 自选分组后台更新：必须另行启动受监管的 worker 或可信定时调用 ----
# MARKET_UPDATE_WORKER_ENABLED=1
# MARKET_UPDATE_WORKER_TOKEN=<至少32字符随机密钥，仅服务器和执行器持有>
# MARKET_UPDATE_ORIGIN=https://your-site.example
# 执行器启动：npm run market:worker；生产队列必须使用上方 PostgreSQL。
# MARKET_UPDATE_LOCAL_PREVIEW=1 # 仅本机隔离预览，线上禁止开启
# 十年导入与补齐验收完成后再开启；未入库的历史数据明确报缺，不由浏览请求抓取。
# MARKET_READ_MODE=database
# 16:30 安排每日更新，06:30 检查补偿；周日完整近期复核，须同时运行上方 worker。
# MARKET_CLOSE_UPDATE_ENABLED=1

# ---- 原服务器：统一公共股票数据 API（GET/只读查询 POST）----
# 端点 /api/market/data；独立密钥优先，未设置时兼容 MARKET_READONLY_TOKEN。
# MARKET_DATA_API_TOKEN=<至少32字符随机密钥，仅在服务器保存>
# 源服务器保留数据库与更新执行器，勿设 MARKET_DATA_MODE=remote。

# ---- 新服务器 / 仅使用原站 API 的本地预览 ----
# MARKET_DATA_MODE=remote
# MARKET_DATA_API_URL=https://original-site.example/api/market/data
# MARKET_DATA_API_ACCESS_TOKEN=<与原服务器数据API密钥相同>
# 此模式不读本地行情/财务/快照，也不写本地市场库；连接失败明确报错。
# 个人账号数据库与 AUTH_* 仍在本服务器配置；不要启动市场更新 worker。

# ---- 手机号登录（验证码由 WorkBuddy 接入后启用，见 WORKBUDDY_AUTH.md）----
# AUTH_SESSION_SECRET=<至少 32 字节的服务端随机密钥>
# APP_ORIGIN=https://a3f223f4c7a12db85.app.workbuddy.host

