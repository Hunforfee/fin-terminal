# 独立部署（源服务器）环境变量模板
#
# 使用：cp deploy/.env.deploy.example deploy/.env.deploy
#       然后填入真实值。deploy/.env.deploy 不得提交到版本库。
#
# 生成随机密钥：openssl rand -base64 32

# ---------------- PostgreSQL ----------------
POSTGRES_DB=fin_market
POSTGRES_USER=fin_market
# 占位符：请替换为强密码（建议 32 字符以上，避免 URL 特殊字符 @ : / ? #）
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD

# ---------------- 公网访问地址 ----------------
# 必须是 https://；worker 启动时会校验，http 非本机地址会被拒绝
PUBLIC_ORIGIN=https://fin.example.com
# 宿主机映射到 web 3000 的端口
WEB_PORT=3000

# ---------------- 后台更新与数据 API 密钥（各至少 32 字符）----------------
# openssl rand -base64 32
MARKET_UPDATE_WORKER_TOKEN=CHANGE_ME_WORKER_TOKEN_AT_LEAST_32_CHARS
MARKET_DATA_API_TOKEN=CHANGE_ME_DATA_API_TOKEN_AT_LEAST_32_CHARS

# ---------------- 可选 ----------------
# 手机号登录会话密钥（不启用登录可留空）
AUTH_SESSION_SECRET=CHANGE_ME_SESSION_SECRET
# hybrid=缓存复用+按需联网抓取；database=纯离线只读库
MARKET_READ_MODE=hybrid
# 历史保留年数（存储与采集上限）
MARKET_RETENTION_YEARS=12
# 收盘后自动更新调度
MARKET_CLOSE_UPDATE_ENABLED=1
# 上游单请求超时（毫秒），境外或链路较差时可调大
UPSTREAM_TIMEOUT_MS=8000

# ---------------- 可选：账号数据独立库 ----------------
# 不设置则回落到文件存储（容器重启丢失），生产建议配置
# DATABASE_URL=postgresql://CHANGE_ME_USER:CHANGE_ME_PASSWORD@postgres:5432/fin_account

# ---------------- 可选：同花顺 iFinD 真实三表 ----------------
# 配置后财务摘要由「行情估值派生」切换为真实财报
# IFIND_BASE_URL=https://your-ifind-gateway/v1
# IFIND_TOKEN=CHANGE_ME_IFIND_TOKEN
