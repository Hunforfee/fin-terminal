# 远程 API 模式（消费者）环境变量模板
#
# 使用：cp deploy/.env.remote.example deploy/.env.remote
#       然后填入真实值。deploy/.env.remote 不得提交到版本库。

# ---------------- 源服务器数据 API ----------------
# 源站需已设置 MARKET_DATA_API_TOKEN，此处填写完全相同的令牌
MARKET_DATA_API_URL=https://source.example.com/api/market/data
MARKET_DATA_API_ACCESS_TOKEN=CHANGE_ME_SAME_AS_SOURCE_MARKET_DATA_API_TOKEN

# ---------------- 公网访问地址 ----------------
PUBLIC_ORIGIN=https://fin-mirror.example.com
WEB_PORT=3000

# ---------------- 可选 ----------------
# 账号数据仍存本机；不设置则回落文件存储
# DATABASE_URL=postgresql://CHANGE_ME_USER:CHANGE_ME_PASSWORD@postgres:5432/fin_account
AUTH_SESSION_SECRET=CHANGE_ME_SESSION_SECRET
UPSTREAM_TIMEOUT_MS=8000
