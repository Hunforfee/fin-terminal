  "bullCase": [
    {
      "point": "主业改善有现金支持",
      "detail": "若道路货运与物流服务的需求和单位经济改善同时转化为现金，而非只表现为应收或存货扩张，才支持更可持续的正向判断。收入下降而归母利润改善，需判断来自结构与成本改善还是一次性因素，不能把利润恢复等同需求恢复。"
    },
    {
      "point": "优势转为持续回报",
      "detail": "港口区位、航线密度和客户网络需由单位吞吐回报、装载率、客户留存及稳定现金实现。需要连续报告期证据支持，不能仅凭管理层愿景或同业估值。"
    },
    {
      "point": "增量投入形成价值",
      "detail": "货运量、费率、航线结构、船舶租金和燃料成本共同影响利润；高运价若来自短期拥堵，持续性应单独验证。新业务或项目应以增量回报覆盖资本成本为条件，不预先把规划规模或技术指标计为确定利润。"
    }
  ],
  "bearCase": [
    {
      "point": "关键经营变量失效",
      "detail": "贸易放缓、运力供给、地缘绕航和运价下行会冲击回报；不同航区和货种的周期不应简单类比。"
    },
    {
      "point": "利润现金或资本偏离",
